{
  "name": "frontline-duel",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.engine.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:fuzz": "vitest run --project fuzz",
    "rules:sections": "tsx scripts/extract-cr-sections.ts",
    "check:matrix": "tsx scripts/check-matrix.ts --milestone M2",
    "check:assets": "tsx scripts/check-assets.ts",
    "build:web": "expo export --platform web",
    "e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm test && npm run test:fuzz && npm run check:matrix && npm run check:assets && npm run build:web && npm run e2e"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "expo": "~57.0.27",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "~0.21.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "serve": "^14.2.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
